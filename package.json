{
  "name": "class-finder",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:build": "cd scraper && uv run uoft-scraper build --out ../data",
    "data:rooms": "cd scraper && uv run uoft-scraper rebuild-rooms --data ../data",
    "data:refresh": "node scripts/refresh-data.mjs",
    "data:rooms:utsc": "node scripts/fetch-utsc-availability.mjs",
    "data:weekly": "node scripts/weekly-refresh.mjs",
    "data:verify": "cd scraper && uv run uoft-scraper verify --data ../data",
    "data:size": "node scripts/check-payload-size.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "og:image": "node scripts/make-og-image.mjs",
    "scraper:test": "cd scraper && uv run pytest"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "description": "Find UofT classes and classrooms across Mississauga, St. George and Scarborough: published classroom availability, complete course schedules, and room-level search.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "uoft",
    "university-of-toronto",
    "timetable",
    "classroom-availability",
    "course-schedule"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adz1x/class_finder.git"
  },
  "bugs": {
    "url": "https://github.com/Adz1x/class_finder/issues"
  },
  "homepage": "https://github.com/Adz1x/class_finder#readme"
}
