{
  "name": "class-finder",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:build": "cd scraper && uv run uoft-scraper build --out ../data",
    "data:verify": "cd scraper && uv run uoft-scraper verify --data ../data",
    "data:size": "node scripts/check-payload-size.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "scraper:test": "cd scraper && uv run pytest"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "description": "Find UofT classes and classrooms: classroom availability from the UTM space database and complete course schedules from the UofT timetable API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adz1x/class_finder.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Adz1x/class_finder/issues"
  },
  "homepage": "https://github.com/Adz1x/class_finder#readme"
}
